<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Your Name | Licensed Life Insurance Agent</title>
  <meta name="description" content="Protect what matters most. Term, whole, and final expense life insurance with fast quotes and personal guidance." />
  <meta property="og:title" content="Life Insurance | Protect What Matters Most" />
  <meta property="og:description" content="Term, whole, and final expense life insurance with fast quotes and personal guidance." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/og-image.jpg" />
  <meta name="theme-color" content="#0f172a" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#0f172a; /* slate-900 */
      --card:#111827; /* gray-900 */
      --muted:#94a3b8; /* slate-400 */
      --text:#e5e7eb; /* gray-200 */
      --brand:#10b981; /* emerald-500 */
      --brand-600:#059669; /* emerald-600 */
      --accent:#38bdf8; /* sky-400 */
      --ring: rgba(16,185,129,.35);
    }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0;background:linear-gradient(180deg,#0b1222, #0f172a 40%, #0b1222);color:var(--text);font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;}
    a{color:var(--accent);text-decoration:none}
    a:hover{text-decoration:underline}
    .container{max-width:1100px;margin:0 auto;padding:24px}
    header{position:sticky;top:0;backdrop-filter:saturate(140%) blur(8px);background:rgba(15,23,42,.65);border-bottom:1px solid rgba(148,163,184,.15);z-index:50}
    .nav{display:flex;align-items:center;justify-content:space-between;gap:16px}
    .logo{display:flex;align-items:center;gap:12px;font-weight:800;letter-spacing:.4px}
    .badge{font-size:12px;background:rgba(56,189,248,.12);color:#bae6fd;border:1px solid rgba(56,189,248,.35);padding:4px 8px;border-radius:999px}
    .cta{display:inline-flex;align-items:center;gap:10px;background:var(--brand);color:#052e1b;font-weight:700;border:none;border-radius:12px;padding:12px 18px;cursor:pointer;box-shadow:0 10px 24px rgba(16,185,129,.25);transition:.2s transform}
    .cta:hover{transform:translateY(-1px);}
    .hero{display:grid;grid-template-columns:1.1fr .9fr;gap:32px;align-items:center;padding:56px 0}
    .hero h1{font-size:clamp(32px,5vw,52px);line-height:1.05;margin:0 0 12px}
    .hero p{color:var(--muted);font-size:18px;margin:0 0 18px}
    .card{background:linear-gradient(180deg,rgba(255,255,255,.02),rgba(255,255,255,.01));border:1px solid rgba(148,163,184,.15);border-radius:18px;padding:22px}
    .list{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}
    .list .card{min-height:120px}
    .check{color:var(--brand);margin-right:8px}
    .section{padding:56px 0}
    .section h2{font-size:28px;margin:0 0 12px}
    .sub{color:var(--muted);margin:0 0 24px}
    .about{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}
    .about img{width:100%;border-radius:16px;border:1px solid rgba(148,163,184,.2);}
    form{display:grid;gap:12px}
    label{font-weight:600}
    input, textarea{width:100%;background:#0b1222;color:var(--text);border:1px solid rgba(148,163,184,.25);border-radius:12px;padding:12px 14px;outline:none}
    input:focus, textarea:focus{box-shadow:0 0 0 4px var(--ring);border-color:var(--brand)}
    textarea{min-height:120px;resize:vertical}
    .two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .notice{font-size:12px;color:#9ca3af}
    .trust{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
    .trust .card{display:flex;gap:12px;align-items:center}
    footer{border-top:1px solid rgba(148,163,184,.15);padding:24px 0;color:#94a3b8;font-size:14px}
    .disclaimer{font-size:12px;color:#9ca3af;margin-top:12px}
    @media (max-width: 900px){
      .hero{grid-template-columns:1fr;}
      .about{grid-template-columns:1fr}
      .list{grid-template-columns:1fr}
      .trust{grid-template-columns:1fr 1fr}
    }
  </style>
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"InsuranceAgency",
    "name":"Your Name – Life Insurance",
    "areaServed":"Missouri, Kentucky, Illinois",
    "telephone":"+1-555-123-4567",
    "url":"https://your-domain.example",
    "sameAs":[],
    "address":{
      "@type":"PostalAddress",
      "addressLocality":"Your City",
      "addressRegion":"MO",
      "addressCountry":"US"
    }
  }
  </script>
</head>
<body>
  <!-- Header -->
  <header>
    <div class="container nav">
      <div class="logo">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2l7 4v6c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-4z" stroke="#38bdf8" stroke-width="1.5" fill="rgba(56,189,248,.08)"/></svg>
        <span>Your Name</span>
        <span class="badge">Licensed Life Insurance Agent</span>
      </div>
      <div>
        <a class="cta" href="#contact">Get a Quote</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <main class="container hero">
    <div>
      <h1>Protect What Matters Most — With Coverage That Fits</h1>
      <p>Simple terms, clear options, and personal service. I help families and business owners choose <strong>term</strong>, <strong>whole</strong>, and <strong>final expense</strong> policies that match their goals and budget.</p>
      <div class="list">
        <div class="card"><strong class="check">✓</strong> Same‑day quotes</div>
        <div class="card"><strong class="check">✓</strong> No‑pressure consultations</div>
        <div class="card"><strong class="check">✓</strong> Claims & policy support</div>
      </div>
    </div>
    <div class="card">
      <h2 style="margin-top:0">Request Your Free Quote</h2>
      <p class="sub">Answer a few quick questions and I’ll follow up shortly.</p>
      <!-- Contact Form (Formspree-ready). Replace YOUR_FORM_ID below. -->
      <form id="quoteForm" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
        <input type="hidden" name="form-name" value="Quote Request" />
        <div class="two">
          <div>
            <label for="name">Full Name</label>
            <input id="name" name="name" autocomplete="name" required />
          </div>
          <div>
            <label for="email">Email</label>
            <input id="email" type="email" name="email" autocomplete="email" required />
          </div>
        </div>
        <div class="two">
          <div>
            <label for="phone">Phone</label>
            <input id="phone" type="tel" name="phone" autocomplete="tel" required />
          </div>
          <div>
            <label for="state">State</label>
            <input id="state" name="state" placeholder="MO / KY / IL" required />
          </div>
        </div>
        <div class="two">
          <div>
            <label for="coverage">Coverage Type</label>
            <input id="coverage" name="coverage" placeholder="Term, Whole, Final Expense..." />
          </div>
          <div>
            <label for="amount">Coverage Amount</label>
            <input id="amount" name="amount" placeholder="$250,000" />
          </div>
        </div>
        <div>
          <label for="message">Anything else?</label>
          <textarea id="message" name="message" placeholder="Tell me about your goals or timeline..."></textarea>
        </div>
        <button class="cta" type="submit">Send Request</button>
        <p id="formStatus" class="notice" role="status" aria-live="polite"></p>
        <p class="notice">By submitting, you agree to be contacted about insurance products. This is not an offer of coverage. All applications subject to underwriting.</p>
      </form>
    </div>
  </main>

  <!-- Trust markers -->
  <section class="container section" aria-label="Trust">
    <div class="trust">
      <div class="card"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M20 7l-9 9-5-5" stroke="#10b981" stroke-width="2"/></svg>Licensed & State‑Certified</div>
      <div class="card"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#10b981" stroke-width="2"/></svg>Multiple Carrier Options</div>
      <div class="card"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 12h16M12 4v16" stroke="#10b981" stroke-width="2"/></svg>Custom Coverage Designs</div>
      <div class="card"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2l7 4v6c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-4z" stroke="#10b981" stroke-width="2"/></svg>Ongoing Client Support</div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="container section">
    <h2>About Me</h2>
    <p class="sub">I’m <strong>Your Name</strong>, a licensed life insurance agent serving families and businesses across Missouri, Kentucky, and Illinois. I focus on education first — walking you through term, whole, and final expense options so you can choose confidently.</p>
    <div class="about">
      <div class="card">
        <h3 style="margin-top:0">How I Work</h3>
        <ul>
          <li>Short, friendly discovery call to learn your goals</li>
          <li>Compare multiple carriers for price & fit</li>
          <li>Clear proposal with next steps — no pressure</li>
          <li>Help with applications and ongoing policy service</li>
        </ul>
      </div>
      <img src="https://images.unsplash.com/photo-1520975922284-8b456906c813?q=80&w=1600&auto=format&fit=crop" alt="Friendly insurance advisor meeting with a family" />
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="container section">
    <h2>Contact</h2>
    <p class="sub">Prefer to call or text? <a href="tel:+15551234567">+1 (555) 123‑4567</a> • <a href="mailto:you@email.com">you@email.com</a></p>
    <div class="card">
      <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
        <div class="two">
          <div>
            <label for="cname">Name</label>
            <input id="cname" name="name" required />
          </div>
          <div>
            <label for="cemail">Email</label>
            <input id="cemail" type="email" name="email" required />
          </div>
        </div>
        <div>
          <label for="cmessage">Message</label>
          <textarea id="cmessage" name="message" required></textarea>
        </div>
        <button class="cta" type="submit">Send Message</button>
        <p class="notice">I’ll reply within one business day.</p>
      </form>
    </div>
    <p class="disclaimer">Disclaimer: Information on this website is for educational purposes only and does not constitute a guarantee of coverage. Policy availability, features, and premiums depend on underwriting and state regulations.</p>
  </section>

  <footer>
    <div class="container" style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap">
      <div>© <span id="year"></span> Your Name — Life Insurance</div>
      <div>National Producer # • State Licenses: MO, KY, IL</div>
    </div>
  </footer>

  <script>
    // Dynamic year
    document.getElementById('year').textContent = new Date().getFullYear();

    // Optional: client-side validation + inline status for the hero form
    const form = document.getElementById('quoteForm');
    const status = document.getElementById('formStatus');
    if (form) {
      form.addEventListener('submit', function(e){
        // Remove the below line if you're using Formspree/Netlify and want a normal submit
        // e.preventDefault();
        status.textContent = 'Submitting...';
      });
    }
  </script>
</body>
</html>
